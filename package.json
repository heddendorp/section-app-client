{
  "name": "@tumi/legacy-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently --kill-others-on-fail \"yarn start\" \"yarn codegen --watch\"",
    "dev:light": "concurrently --kill-others-on-fail \"yarn start --configuration=light\" \"yarn codegen --watch\"",
    "start": "ng serve",
    "build": "ng build && yarn sentry:sourcemaps",
    "build:no-maps": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write .",
    "codegen": "yarn graphql-codegen",
    "codegen:watch": "yarn graphql-codegen --watch",
    "lint": "ng lint",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org esn-tumi-ev --project legacy-app ./dist/legacy-app && sentry-cli sourcemaps upload --org esn-tumi-ev --project legacy-app ./dist/legacy-app"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.5",
    "@angular/cdk": "^19.0.4",
    "@angular/common": "^19.0.5",
    "@angular/compiler": "^19.0.5",
    "@angular/core": "^19.0.5",
    "@angular/forms": "^19.0.5",
    "@angular/google-maps": "^19.0.4",
    "@angular/material": "^19.0.4",
    "@angular/material-luxon-adapter": "^19.0.4",
    "@angular/platform-browser": "^19.0.5",
    "@angular/platform-browser-dynamic": "^19.0.5",
    "@angular/router": "^19.0.5",
    "@angular/service-worker": "^19.0.5",
    "@apollo/client": "3.11.8",
    "@auth0/auth0-angular": "^2.2.3",
    "@azure/storage-blob": "^12.25.0",
    "@ng-web-apis/common": "^4.6.5",
    "@sentry/angular-ivy": "^7.119.0",
    "@typescript-eslint/utils": "^8.8.0",
    "ag-charts-angular": "^10.2.0",
    "ag-grid-angular": "^32.2.1",
    "ag-grid-community": "^32.2.1",
    "apollo-angular": "^7.2.0",
    "backoff-rxjs": "^7.0.0",
    "graphql": "^16.9.0",
    "highcharts": "^11.4.8",
    "highcharts-angular": "^4.0.1",
    "lodash-es": "^4.17.21",
    "luxon": "^3.5.0",
    "marked": "^14.1.2",
    "ngx-markdown": "^18.1.0",
    "qr-scanner": "^1.4.2",
    "rxjs": "~7.8.1",
    "tslib": "^2.7.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.6",
    "@angular-eslint/builder": "19.0.2",
    "@angular-eslint/eslint-plugin": "19.0.2",
    "@angular-eslint/eslint-plugin-template": "19.0.2",
    "@angular-eslint/schematics": "19.0.2",
    "@angular-eslint/template-parser": "19.0.2",
    "@angular/cli": "^19.0.6",
    "@angular/compiler-cli": "^19.0.5",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-apollo-angular": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@parcel/watcher": "^2.4.1",
    "@sentry/cli": "^2.36.6",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.15",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.10",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.7.4",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jasmine-core": "~5.3.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.5.4"
  },
  "volta": {
    "node": "22.9.0"
  },
  "packageManager": "yarn@4.1.1"
}

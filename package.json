{
  "name": "@tumi/legacy-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "concurrently --kill-others-on-fail \"yarn start\" \"yarn codegen --watch\"",
    "dev:light": "concurrently --kill-others-on-fail \"yarn start --configuration=light\" \"yarn codegen --watch\"",
    "start": "ng serve",
    "build": "ng build && yarn sentry:sourcemaps",
    "build:no-maps": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "format": "prettier --write .",
    "codegen": "yarn graphql-codegen",
    "codegen:watch": "yarn graphql-codegen --watch",
    "lint": "ng lint",
    "lint:budget": "node scripts/check-eslint-budget.cjs",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org esn-tumi-ev --project legacy-app ./dist/legacy-app && sentry-cli sourcemaps upload --org esn-tumi-ev --project legacy-app ./dist/legacy-app"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.6",
    "@angular/cdk": "22.0.4",
    "@angular/common": "22.0.6",
    "@angular/compiler": "22.0.6",
    "@angular/core": "22.0.6",
    "@angular/forms": "22.0.6",
    "@angular/google-maps": "22.0.4",
    "@angular/material": "22.0.4",
    "@angular/material-luxon-adapter": "22.0.4",
    "@angular/platform-browser": "22.0.6",
    "@angular/router": "22.0.6",
    "@angular/service-worker": "22.0.6",
    "@apollo/client": "4.2.6",
    "@auth0/auth0-angular": "2.10.1",
    "@azure/storage-blob": "12.33.0",
    "@ng-web-apis/common": "4.14.1",
    "@sentry/angular": "10.65.0",
    "ag-charts-angular": "11.3.2",
    "ag-charts-community": "11.3.2",
    "ag-grid-angular": "33.3.2",
    "ag-grid-community": "33.3.2",
    "apollo-angular": "14.1.0",
    "graphql": "^16.14.2",
    "katex": "0.16.47",
    "lodash-es": "4.18.1",
    "luxon": "3.7.2",
    "marked": "18.0.6",
    "marked-katex-extension": "5.1.10",
    "ngx-markdown": "22.0.0",
    "qr-scanner": "^1.4.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/build": "22.0.6",
    "@angular/cli": "22.0.6",
    "@angular/compiler-cli": "22.0.6",
    "@eslint/js": "9.39.5",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-apollo-angular": "5.0.1",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@parcel/watcher": "2.5.6",
    "@sentry/cli": "2.58.6",
    "@tailwindcss/typography": "0.5.20",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "3.7.2",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@typescript-eslint/types": "8.63.0",
    "@typescript-eslint/utils": "8.63.0",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.0.0",
    "autoprefixer": "10.5.2",
    "concurrently": "9.2.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "postcss": "8.5.16",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.10"
  },
  "volta": {
    "node": "24.18.0"
  },
  "packageManager": "yarn@4.1.1",
  "resolutions": {
    "lodash": "4.18.1"
  }
